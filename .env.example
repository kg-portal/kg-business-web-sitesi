# ---------------------------------------------------------------------------
# KG Business Website V2 – Umgebungsvariablen (Vorlage)
# Kopieren nach .env.local (Entwicklung) bzw. /etc/kg-business-web/.env (Server).
# NIEMALS echte Werte ins Repository committen.
# ---------------------------------------------------------------------------

# Öffentliche Basis-URL (Canonicals, Sitemap, OG). Wird beim Build eingebettet.
NEXT_PUBLIC_SITE_URL=https://www.kg-business.de

# "production" = indexierbar (erst nach Freigabe!). Alles andere = noindex + robots Disallow.
# Wird beim Build für statische Seiten ausgewertet → Build mit dem richtigen Wert erstellen.
SITE_ENV=preview

# --- Geheimnisse (Pflicht im Produktionsbetrieb) ---------------------------
# Mindestens 32 Zeichen, z. B.: openssl rand -base64 48
APP_SECRET=
# Genau 32 Byte Base64, z. B.: openssl rand -base64 32
# ACHTUNG: Ohne diesen Schlüssel sind gespeicherte Anfragen/Uploads nicht mehr lesbar → sicher aufbewahren!
LEAD_ENCRYPTION_KEY=

# --- Datenhaltung ------------------------------------------------------------
# Verzeichnis für SQLite-Datenbank und verschlüsselte Uploads (außerhalb des Webroots, chmod 700)
DATA_DIR=./data
LEAD_RETENTION_DAYS=180
UPLOAD_RETENTION_DAYS=90

# --- Sicherheit ----------------------------------------------------------------
# Zusätzliche erlaubte Origins für die Formular-API (kommagetrennt), z. B. Preview-Domain
ALLOWED_ORIGINS=
# true, wenn der Dienst hinter Caddy/Nginx läuft (X-Forwarded-For wird dann für Rate-Limits genutzt)
TRUST_PROXY=false
RATE_LIMIT_SUBMISSIONS_PER_HOUR=5
RATE_LIMIT_TOKENS_PER_HOUR=60
FORM_MIN_FILL_SECONDS=4
FORM_TOKEN_MAX_AGE_HOURS=6
DUPLICATE_WINDOW_HOURS=24
# E-Mail-Domains, deren Anfragen als Test gelten und NIE ans CRM gehen
TEST_EMAIL_DOMAINS=example.com,example.org,example.net,test.invalid
# HSTS + upgrade-insecure-requests (nur aktivieren, wenn ausschließlich HTTPS ausgeliefert wird)
ENABLE_HSTS=false

# --- CRM (bestehendes KG-Business-CRM) ------------------------------------------
# disabled (Standard) | mock (nur Test/Preview, schreibt data/crm-mock-outbox.jsonl) | live
CRM_MODE=disabled
# Live-Übertragung nur mit ausdrücklicher Freigabe durch KG Business:
CRM_LIVE_APPROVED=false
CRM_ENDPOINT=
CRM_API_TOKEN=
CRM_TIMEOUT_MS=10000
CRM_MAX_ATTEMPTS=8

# --- E-Mail-Benachrichtigung -----------------------------------------------------
# disabled (Standard) | log (nur Protokolleintrag ohne Personendaten) | smtp
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO_INTERNAL=
# Kontaktdaten in der internen Benachrichtigung mitsenden (nur mit TLS-gesichertem Postfach)
MAIL_INCLUDE_CONTACT=false
# Bestätigungsmail an Kunden – erst nach Freigabe aktivieren
CUSTOMER_CONFIRMATION_EMAIL=false

# --- Virenscan (ClamAV clamd) -----------------------------------------------------
# Leer = kein Scan (Uploads bleiben als "not_scanned" gekennzeichnet und gehen nicht ans CRM)
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# true = Uploads ablehnen, wenn kein Scanner erreichbar ist
UPLOAD_SCAN_REQUIRED=false

# --- Hintergrundaufgaben (CRM-Outbox jede Minute, Löschlauf alle 6 Stunden) --------
BACKGROUND_JOBS=true
